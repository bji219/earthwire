# Freesound API (required for Freesound tab in Sample Browser)
# Register at: https://freesound.org/apiv2/apply/
FREESOUND_CLIENT_ID=your_client_id_here

# Xeno-canto API key (optional — keyless works currently)
# XENO_CANTO_KEY=

# Public URL of the deployed site. Printed into the key PDF that buyers follow,
# so a wrong value sends every customer to a dead link.
SITE_URL=https://earthwire.app

# Etsy shop, used in the PDF's "message me" line.
ETSY_SHOP_URL=idw3d.etsy.com

# Secret used to sign and verify Earthwire Pro unlock keys.
# Any long random string; generate one with:  openssl rand -base64 48
# Server-only — never prefix this with PUBLIC_, or SvelteKit will ship it to the browser.
# Changing it invalidates every key already sold.
LICENSE_SECRET=
